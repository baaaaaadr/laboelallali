rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy analysisCatalog collection (kept for backward compatibility)
    match /analysisCatalog/{analysisId} {
      allow read: if true; // Anyone can read the catalog
      allow write: if false; // Only admin can modify via Firebase Console
    }

    // New analyses collection (individual medical tests)
    match /analyses/{analyseId} {
      allow read: if true; // Anyone can read the analyses catalog
      allow write: if false; // Only admin/script can modify via Google Sheets sync
    }

    // New bilans collection (test packs/bundles)
    match /bilans/{bilanId} {
      allow read: if true; // Anyone can read the bilans catalog
      allow write: if false; // Only admin/script can modify via Google Sheets sync
    }

    // Allow users to submit appointment requests
    match /appointmentRequests/{requestId} {
      allow create: if true; // Anyone can create appointment requests
      allow read, update, delete: if false; // Only admin can read/modify
    }

    // Allow public read access to the medecins collection
    match /medecins/{medecinId} {
      allow read: if true; // Anyone can read the doctors directory
      allow write: if false; // Only admin/script can modify via Google Sheets sync
    }

    // Authenticated users read/write ONLY their own profile — and may NEVER set or
    // change the privileged fields role / requester_id / type. Those are managed
    // exclusively server-side via the Admin SDK (which bypasses these rules):
    // adminSetRequester, adminSetStaff, adminSetAdmin, adminFulfillAccessRequest.
    // This blocks self-promotion to staff/owner AND self-pointing requester_id at
    // another patient's id (which fetchResults/adminTestResults would otherwise trust).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Create: a fresh profile may not include any privileged field.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['role', 'requester_id', 'type']);

      // Update: allowed only if it does not CHANGE any privileged field. diff()
      // compares values, so a {merge:true} write that echoes an unchanged role /
      // requester_id is fine — only an actual change is blocked.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['role', 'requester_id', 'type']);
    }

    // Default deny for anything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}