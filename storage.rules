rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for prescription uploads (ordonnances)
    match /ordonnances/{fileName} {
      // Allow public read access (URLs are shared via WhatsApp/Email)
      allow read: if true;

      // Allow write only if:
      // 1. File size is under 5MB
      // 2. File type is JPEG, PNG, or PDF
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/jpeg')
                       || request.resource.contentType.matches('image/png')
                       || request.resource.contentType.matches('application/pdf'));
    }

    // CVs and letters of « Emploi & Stage » (candidatures/{id}/…) are written
    // and read ONLY through the Admin SDK (submitApplication /
    // adminGetApplicationFile): no rule here, so the default deny below covers
    // them — never give that folder the public read of the prescriptions.

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
