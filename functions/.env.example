# Firebase Functions Environment Variables

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=noreply@laboelallali.ma
LAB_EMAIL=contact@laboelallali.ma

# CyberLab results bridge (fetchResults)
# Base origin of the lab results API (scheme + host, no trailing slash).
# Local testing points at the mock server; production is the private Cloudflare
# subdomain. Non-secret → put the real value in functions/.env (gitignored).
CYBERLAB_API_URL=http://127.0.0.1:3001
#
# CYBERLAB_API_KEY and CYBERLAB_HMAC_SECRET are SECRETS — never put real values
# here. Production: `firebase functions:secrets:set CYBERLAB_API_KEY` (and
# CYBERLAB_HMAC_SECRET). Local: functions/.secret.local (gitignored via *.local).
