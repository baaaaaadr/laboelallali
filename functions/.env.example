# Firebase Functions Environment Variables
#
# Appointment-notification emails are handled by the Next.js API route
# (src/app/api/send-appointment/route.ts, nodemailer + Gmail SMTP via SMTP_USER /
# SMTP_PASS in the app's root env) — NOT by a Cloud Function. No SendGrid.

# CyberLab results bridge (fetchResults)
# Base origin of the lab results API (scheme + host, no trailing slash).
# Local testing points at the mock server; production is the private Cloudflare
# subdomain. Non-secret → put the real value in functions/.env (gitignored).
CYBERLAB_API_URL=http://127.0.0.1:3001
#
# CYBERLAB_API_KEY and CYBERLAB_HMAC_SECRET are SECRETS — never put real values
# here. Production: `firebase functions:secrets:set CYBERLAB_API_KEY` (and
# CYBERLAB_HMAC_SECRET). Local: functions/.secret.local (gitignored via *.local).

# Server monitoring (checkCyberlabHealth + joinOutageWaitlist + the
# patient-impact alert in fetchResults) — see docs/integrations/server-monitoring.md
# Staff alert recipients, comma-separated (code default = the 4 lab addresses).
ALERT_EMAILS=azizelallali@gmail.com,laboelallali@gmail.com,communication.labo.elallali@gmail.com,hassanelallali@gmail.com
# Public app origin used in patient "server is back" emails.
APP_URL=https://www.laboelallali.com
# Lab-editor-blessed test id probed every 5 min (list-only, no PDFs).
HEALTHCHECK_REQUESTER_ID=7587
#
# SMTP_USER and SMTP_PASS are SECRETS (Gmail address + app password):
# `firebase functions:secrets:set SMTP_USER` / `SMTP_PASS`. Local/emulator:
# functions/.secret.local. A placeholder value (anything without "@") switches
# the mailer to simulated (log-only) mode — deploys keep working without them.
